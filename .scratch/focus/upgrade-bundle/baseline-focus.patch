+
+async function screen(terminal: VirtualTerminal) {
+	await terminal.waitForRender();
+	return terminal.getViewport().join("\n");
+}
+
+function deferred() {
+	let resolve = () => {};
+	const promise = new Promise<void>((done) => {
+		resolve = done;
+	});
+	return { promise, resolve };
